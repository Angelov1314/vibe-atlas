# Reference only. `pnpm setup:local` creates a fresh random local secret.
# Do not distribute an actual .dev.vars file or reuse its identity secret.
# IDENTITY_HMAC_SECRET=<generated by setup:local>
# Local requests infer their own origin. Set the exact HTTPS origin in production.
# SITE_ORIGIN=https://your-deployed-site.example
# ADMIN_USER_ID=<explicitly verified administrator subject>
# TURNSTILE_SITE_KEY=<public widget key>
# TURNSTILE_SECRET_KEY=<server-side secret>
